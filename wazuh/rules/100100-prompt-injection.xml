<!--
Wazuh rules for Clinical AI Gateway prompt injection detections.

Install path example:
  /var/ossec/etc/rules/100100-prompt-injection.xml

MITRE ATLAS mapping: docs/mitre-atlas-mapping.md
-->

<group name="clinical_ai_gateway,llm_security,prompt_injection,">

  <rule id="100100" level="8">
    <if_sid>86600</if_sid>
    <field name="event_type">query</field>
    <field name="decision">blocked</field>
    <field name="reason" type="pcre2">^blocked_pattern:.*</field>
    <description>Clinical AI Gateway blocked a prompt injection attempt</description>
    <mitre>
      <id>AML.T0051</id>
    </mitre>
    <group>clinical_ai_gateway,prompt_injection,blocked,</group>
  </rule>

  <rule id="100101" level="10">
    <if_sid>100100</if_sid>
    <field name="reason" type="pcre2">system prompt</field>
    <description>Clinical AI Gateway blocked a system prompt extraction attempt</description>
    <mitre>
      <id>AML.T0051</id>
    </mitre>
    <group>clinical_ai_gateway,prompt_injection,system_prompt_extraction,</group>
  </rule>

  <rule id="100102" level="9">
    <if_sid>100100</if_sid>
    <field name="reason" type="pcre2">ignore all previous instructions</field>
    <description>Clinical AI Gateway blocked an instruction override attempt</description>
    <mitre>
      <id>AML.T0051</id>
    </mitre>
    <group>clinical_ai_gateway,prompt_injection,instruction_override,</group>
  </rule>

  <!-- Repeated probing: 3+ blocked events from same user in 5 minutes -->
  <rule id="100200" level="10" frequency="3" timeframe="300">
    <if_matched_sid>100100</if_matched_sid>
    <same_field>user_id</same_field>
    <description>Clinical AI Gateway detected repeated prompt injection attempts from same user</description>
    <mitre>
      <id>AML.T0051</id>
    </mitre>
    <group>clinical_ai_gateway,prompt_injection,probing,</group>
  </rule>

  <!-- PHI probing: queries targeting personal health information -->
  <rule id="100300" level="9">
    <if_sid>86600</if_sid>
    <field name="event_type">query</field>
    <field name="query" type="pcre2">(?i).*(ssn|social security|date of birth|dob|address|insurance|phone number|contact info|medical record).*</field>
    <description>Clinical AI Gateway detected potential PHI probing query</description>
    <mitre>
      <id>AML.T0057</id>
    </mitre>
    <group>clinical_ai_gateway,phi_probing,</group>
  </rule>

  <!-- Abnormal query length: potential stuffing or exfiltration -->
  <rule id="100400" level="7">
    <if_sid>86600</if_sid>
    <field name="event_type">query</field>
    <field name="query_length_bucket">large</field>
    <description>Clinical AI Gateway received abnormally long query</description>
    <mitre>
      <id>AML.T0051</id>
    </mitre>
    <group>clinical_ai_gateway,abnormal_usage,</group>
  </rule>

  <rule id="100401" level="8">
    <if_sid>100400</if_sid>
    <field name="decision">blocked</field>
    <description>Clinical AI Gateway blocked abnormally long query (potential abuse)</description>
    <mitre>
      <id>AML.T0051</id>
    </mitre>
    <group>clinical_ai_gateway,abnormal_usage,blocked,</group>
  </rule>

</group>
